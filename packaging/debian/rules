#!/usr/bin/make -f
# debhelper rules: plain CMake build, no tests at package build time
# (fcitx5 runtime is not available in a chroot).

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake --builddirectory=build

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release -GNinja
